APP_NAME="User Todo API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# DB_HOST is the Compose service name, not localhost.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=user_todo_api
DB_USERNAME=utapi
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# --- Redis --------------------------------------------------------------
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Queue and cache ----------------------------------------------------
# Redis is the queue driver, not only a cache. The worker service consumes
# this connection; the cache store backs the JWT token blacklist.
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local

# --- Auth ---------------------------------------------------------------
# Populated by `php artisan jwt:secret`. Leaving it empty produces a 500 on
# the first token issue, so run that command during setup.
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=30

# --- API docs -----------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=true

# --- Host-side settings -------------------------------------------------
# Compose reads these for interpolation. UID and GID are passed as build args
# so the container user matches your host user and bind mounts stay writable.
APP_PORT=8080
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380
UID=1000
GID=1000
