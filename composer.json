{
    "name": "madalitsonyemba/user-todo-api",
    "type": "project",
    "description": "Dockerised RESTful API managing users and a per-user todo list, behind JWT auth with Redis-backed queues.",
    "keywords": ["laravel", "api", "jwt", "todo"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "darkaonline/l5-swagger": "^8.6",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^10.10",
        "laravel/tinker": "^2.8",
        "tymon/jwt-auth": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/boost": "^1.8",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                 "ignore-id": {
                    "PKSA-mdq4-51ck-6kdq": "CVE-2026-48019, CRLF injection in the default email validation rule. Affects 10.x with no patched 10.x release. Mitigated in application code: Form Requests validate with email:rfc,strict and reject control characters. See README.",
                    "PKSA-3r5d-mb8f-1qw9": "Same CRLF injection as CVE-2026-48019, reported via a second advisory source. Patched only in 12.60.0 and later. Same mitigation applies.",
                    "PKSA-m5cs-t1y6-qpcs": "Temporary signed URL path confusion. Patched only in 12.61.1 and later, so no 10.x fix exists. Not reachable here: this API issues no temporary signed URLs."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
